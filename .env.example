# ---------------------------------------------------------------
# NeoStrategy — environment variables
# Copy to .env and fill in the values from your Supabase project.
# Never commit .env — only this example file.
# ---------------------------------------------------------------

# --- Client-visible (bundled into the browser build) -------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server-only (server functions, SSR, API routes) -------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Service role key: bypasses RLS. Server-only, never expose to the browser.
# Required by the Paystack webhook and admin server functions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ----------------------------------------------------
# Paystack secret key (sk_test_... or sk_live_...).
# Without it, checkout falls back to manual/WhatsApp mode.
PAYSTACK_SECRET_KEY=

# Paystack webhook signature secret used by /api/public/webhooks/paystack.
# In most Paystack setups this is the same value as PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
